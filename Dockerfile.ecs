# CI builds and tests the bootJar before packaging it; there is exactly one input JAR.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S spring && adduser -S spring -G spring
COPY --chown=spring:spring build/libs/*-SNAPSHOT.jar /app/app.jar
USER spring
EXPOSE 3000 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
